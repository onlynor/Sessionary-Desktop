{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": [], "typeRoots": ["../../Sessionary/node_modules/@types", "node_modules/@types"],
    "baseUrl": ".",
    "paths": {
      "@web/*": ["../../Sessionary/web/src/*"],
      "@original/*": ["../../Sessionary/web/src/*"],
      "*": ["../../Sessionary/node_modules/@types/*", "../../Sessionary/node_modules/*", "node_modules/*"]
    }
  },
  "include": ["src"]
}
